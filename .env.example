[TEMPLATE]
# ═══════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════
# Two backend profiles:
#
#   DB_DIALECT=mssql    (default) — local development against SQL Server,
#                       exactly as before. Leave DB_DIALECT unset.
#   DB_DIALECT=postgres — free public demo against Neon Postgres
#                       (see DEPLOYMENT.md).
# ═══════════════════════════════════════════════════════════════════════

# ── Profile A: MS SQL Server (default, unchanged local workflow) ────────
# SQLAlchemy connection string via pyodbc.
#
# Format:
#   mssql+pyodbc://<username>:<password>@<server>/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# IMPORTANT: if your password contains special URL characters
# (@ : / ? # [ ] % etc.), URL-encode them, e.g. "p@ss" -> "p%40ss".
#
# Example matching this project's default local setup (SQL Server 2022
# Developer Edition, AdventureWorks2022, SQL auth as `sa`):
DB_CONNECTION_STRING="mssql+pyodbc://sa:<password>@localhost/adventureWorks?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"

# ── Profile B: PostgreSQL / Neon demo ───────────────────────────────────
# DB_DIALECT=postgres
#
# Option 1 (recommended): paste Neon's own connection string — it works
# as-is (Neon puts the endpoint in the username as `user@ep-...`):
# DB_CONNECTION_STRING="postgresql+psycopg2://<user>@<endpoint>:<password>@<host>/<dbname>?sslmode=require"
#
# Option 2: individual parts (the URI is built for you, sslmode=require
# by default; Neon usernames like "user@ep-xxx" go in DB_USER verbatim):
# DB_DIALECT=postgres
# DB_HOST=ep-cool-name-123456.us-east-2.aws.neon.tech
# DB_NAME=neondb
# DB_USER=<user>            (or <user>@ep-cool-name-123456)
# DB_PASSWORD=<password>
# DB_PORT=5432
# DB_SSLMODE=require

# ── Schema scope (both profiles) ─────────────────────────────────────────
# By default SQLTalk auto-discovers every non-system schema. Set only to
# restrict scope (comma-separated), e.g.:
# DB_SCHEMAS=Production,Sales,Person        (MSSQL)
# DB_SCHEMAS=production,sales               (Postgres demo)

# ═══════════════════════════════════════════════════════════════════════
# LLM PROVIDERS (fallback order = inference speed: Groq → Gemini → OpenRouter)
# ═══════════════════════════════════════════════════════════════════════
# The app builds one SQL agent per (provider, key) and falls back to the
# next agent whenever one errors or rate-limits. Configure at least ONE;
# all three is the most resilient.

# 1) Groq — recommended default (fastest free tier)
# https://console.groq.com/keys
GROQ_API_KEY=
# Model override (default: llama-3.3-70b-versatile):
# GROQ_MODEL=llama-3.3-70b-versatile
# Completion-token budget per Groq request (default 768). Groq's free tier
# enforces small per-model OUTPUT tokens-per-minute quotas (e.g. 1,000 OTPM
# on several models); an uncapped request gets rejected with a 429 before
# generation starts. Keep the default unless you know your model's OTPM.
# GROQ_MAX_TOKENS=768

# 2) Gemini — Google AI Studio free tier
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model override (default: gemini-2.5-flash — the 1.5 generation is retired):
# GEMINI_MODEL=gemini-2.5-flash

# 3) OpenRouter — OpenAI-compatible aggregator
# https://openrouter.ai/keys (no payment method required for free-tier models)
OPENROUTER_API_KEY=
# Any OpenRouter model slug. Free-tier availability changes often — check
# https://openrouter.ai/models?max_price=0. Retired models fail with 404.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Rarely needs changing — override only for a self-hosted OpenRouter-compatible gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Completion-token budget advertised per request (default 8192). OpenRouter
# admits/prices requests against this budget; the cap keeps near-zero-credit
# accounts working. Note: free tier = ~50 free-model requests/day/account.
# OPENROUTER_MAX_TOKENS=8192

# ── Multiple keys per provider (optional) ───────────────────────────────
# Two accepted forms; keys are tried in order before moving to the next
# provider. (The numbered form exists because Streamlit Cloud secrets
# cannot repeat the same key name.)
# GROQ_API_KEY=key1,key2
# GROQ_API_KEY_1=key1
# GROQ_API_KEY_2=key2

# ── Fallback order (optional) ────────────────────────────────────────────
# Comma-separated provider priority for the fallback chain. Default order
# (inference speed): groq,gemini,openrouter. Unknown names are ignored;
# configured providers missing from the list keep a slot at the end of the
# chain (ordering overrides re-prioritize, they never disable).
# LLM_PROVIDER_ORDER=openrouter,groq,gemini

# ── Sampling ─────────────────────────────────────────────────────────────
# 0 = deterministic, higher = more creative. SQL generation prefers 0.
OPENROUTER_TEMPERATURE=0

# ═══════════════════════════════════════════════════════════════════════
# AGENT & SAFETY
# ═══════════════════════════════════════════════════════════════════════
# Max reasoning/tool-call steps before the agent stops and reports progress.
# 10 comfortably covers multi-step questions (list tables -> schema ->
# check -> run -> interpret); an exhausted agent now also triggers the
# provider fallback chain instead of surfacing a half-answer.
AGENT_MAX_ITERATIONS=10

# Max rows a single query is allowed to return. Applied as `TOP N` (MSSQL)
# or `LIMIT N` (Postgres) automatically, per the active dialect.
AGENT_MAX_ROWS=200

# When true (default), destructive statements (DROP/DELETE/TRUNCATE/ALTER/
# INSERT/UPDATE/...) are rejected before reaching the database.
READ_ONLY_MODE=true

# ═══════════════════════════════════════════════════════════════════════
# DEVELOPER MODE
# ═══════════════════════════════════════════════════════════════════════
# When true, a session-only "Developer Mode" section appears in the sidebar
# (model overrides, temporary API keys, provider on/off). Leave unset or
# false in production — the section is completely hidden without it.
# DEV_MODE=true
