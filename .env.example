# ── Database ─────────────────────────────────────────────────────────────
# SQLAlchemy connection string for SQL Server, via pyodbc.
#
# Format:
#   mssql+pyodbc://<username>:<password>@<server>/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# IMPORTANT: if your password contains special URL characters
# (@ : / ? # [ ] % etc.), URL-encode them, e.g. "p@ss" -> "p%40ss".
#
# Example matching this project's default local setup (SQL Server 2022
# Developer Edition, AdventureWorks2022, SQL auth as `sa`):
DB_CONNECTION_STRING="mssql+pyodbc://sa:<password>@localhost/adventureWorks?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────
# Create a key at https://openrouter.ai/keys — no payment method required
# to use free-tier ("...:free") models.
OPENROUTER_API_KEY=

# Any OpenRouter model slug works. Free-tier availability changes often —
# check https://openrouter.ai/models?max_price=0 and swap this if the
# default below has been retired. "openrouter/free" auto-routes to
# whatever free model is currently available if you'd rather not track it.
OPENROUTER_MODEL=meta-llama/llama-3.1-405b-instruct:free

# Rarely needs changing — override only for a self-hosted OpenRouter-compatible gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 0 = deterministic, higher = more creative. SQL generation prefers 0.
OPENROUTER_TEMPERATURE=0

# ── Agent & Safety ───────────────────────────────────────────────────────
# Max reasoning/tool-call steps before the agent stops and reports progress.
AGENT_MAX_ITERATIONS=6

# Max rows a single query is allowed to return.
AGENT_MAX_ROWS=200

# When true (default), destructive statements (DROP/DELETE/TRUNCATE/ALTER/
# INSERT/UPDATE/...) are rejected before reaching the database.
READ_ONLY_MODE=true
